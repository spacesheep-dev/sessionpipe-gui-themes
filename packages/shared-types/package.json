    "directory": "packages/shared-types"
  },
  "homepage": "https://github.com/spacesheep-dev/sessionpipe-gui-themes/tree/main/packages/shared-types#readme",
  "bugs": {
    "url": "https://github.com/spacesheep-dev/sessionpipe-gui-themes/issues"
  },
