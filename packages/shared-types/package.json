{
  "name": "@sessionpipe-gui/theme-types",
  "version": "0.3.0",
  "description": "Type-only mirror of the sessionpipe GUI's extension contracts (shared/theme-api.ts, shared/plugin-api.ts, shared/api.ts).",
  "keywords": [
    "sessionpipe",
    "sessionpipe-gui",
    "sessionpipe-gui-types"
  ],
  "license": "Apache-2.0",
  "repository": {
